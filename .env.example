# Public Supabase project configuration. These values are safe to expose to the
# browser when Row Level Security is enabled and policies are correct.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Canonical application origin used in authentication emails. Use HTTPS outside
# local development and add the matching callback URL in Supabase Auth settings.
APP_BASE_URL=http://127.0.0.1:3001

# Server-only worker credentials. Never prefix these with NEXT_PUBLIC_ and
# never expose them to browser code. Add only when activating the worker or Cua
# adapters; the web app starts without them.
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key
CUA_API_KEY=your-server-only-cua-api-key

# Optional local-only shortcut around email delivery. The server action still
# creates a normal Supabase Auth session and exercises auth.uid() and RLS. It is
# ignored outside `next dev`, on non-loopback origins, without the server secret,
# or when the fixed account does not use the reserved `.invalid` domain.
ENABLE_LOCAL_TEST_LOGIN=false
LOCAL_TEST_USER_EMAIL=roledawn-test@local.invalid

# Explicit, destructive hosted-acceptance gates. Leave unset during ordinary
# development. The project ref must exactly match NEXT_PUBLIC_SUPABASE_URL.
ACCEPTANCE_EXPECTED_SUPABASE_PROJECT_REF=your-project-ref
RUN_HOSTED_MILESTONE_ZERO_ACCEPTANCE=false
# The Career Vault harness and its permanent-cleanup command each require their
# own exact acknowledgement. Keep both false during ordinary development.
RUN_HOSTED_CAREER_VAULT_ACCEPTANCE=false
RUN_HOSTED_CAREER_VAULT_CLEANUP=false
ACCEPTANCE_JOB_URL=https://job-boards.greenhouse.io/anthropic/jobs/5101378008
ACCEPTANCE_RUN_WORKER=false
ACCEPTANCE_KEEP_ARTIFACTS=false
