# Public Supabase project configuration. These values are safe to expose to the
# browser when Row Level Security is enabled and policies are correct.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Canonical application origin used in authentication emails. Use HTTPS outside
# local development and add the matching callback URL in Supabase Auth settings.
APP_BASE_URL=http://127.0.0.1:3001

# Temporary shared access to one EXISTING test account. Anyone with the app URL
# can use that workspace while enabled. No new account is created; RLS stays on.
# Set false and redeploy to restore sign-in and account controls.
ROLEDAWN_SINGLE_ACCOUNT_MODE=false
ROLEDAWN_TEST_ACCOUNT_ID=
# Private key for /auth/test-session?key=… (32+ characters). Unset keeps new shared sessions closed.
ROLEDAWN_TEST_ACCESS_KEY=

# Local Supabase Google provider only. Create a Google Web OAuth client, put
# its non-secret client ID in `supabase/config.toml`, add this secret to the
# ignored `.env.local`, and then enable `[auth.external.google]`.
# Hosted HireWire Google OAuth is configured in the Supabase Dashboard instead.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=your-local-google-oauth-client-secret

# Server-only worker credentials. Never prefix these with NEXT_PUBLIC_ and
# never expose them to browser code. Add only when activating the worker or browser
# adapters; the web app starts without them.
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key
# Required by the bounded local drafting acceptance and any future server-only
# drafting consumer. The browser bundle must never read this value.
OPENAI_API_KEY=your-server-only-openai-api-key

# Form driver. Autopilot sending runs only with `agents` (production value);
# `deterministic` is the legacy no-submit fill path. The OpenAI key needs
# api.agents.read, api.agents.write and api.responses.write.
ROLEDAWN_FORM_DRIVER=agents
# Sends real applications. Keep false locally: `.env.local` may point at the
# hosted database, where local workers would compete with production.
ROLEDAWN_AUTOPILOT_ENABLED=false
# Hosted production workers remain off until their deployment is verified.
ROLEDAWN_HOSTED_WORKERS_ENABLED=false
# Generate with crypto.randomBytes(32).toString('hex'); server/functions only.
ROLEDAWN_WORKER_DISPATCH_SECRET=your-64-character-random-hex-secret
ROLEDAWN_APPLICATION_AGENT_MODEL=gpt-6.1-sol
ROLEDAWN_APPLICATION_AGENT_TIMEOUT_MS=240000
ROLEDAWN_APPLICATION_AGENT_MAX_ACTIONS=80

# Managed browser execution remains off unless this exact gate is true. The
# fill worker creates a fresh, unrecorded Browserbase session per attempt and
# never receives submission authority. The long-running worker retains its
# guarded CDP connection through the session TTL after fill/takeover so the
# candidate can use Live View; one-shot worker:fill still tears down at once.
ROLEDAWN_BROWSERBASE_ENABLED=false
BROWSERBASE_API_KEY=your-server-only-browserbase-api-key
BROWSERBASE_REGION=us-west-2
BROWSERBASE_API_TIMEOUT_MS=20000

# Long-running worker-service settings. Deploy `Dockerfile.worker` separately
# from the web process. Each lane has its own bounded poll cadence and backoff;
# `/live` reports process liveness and `/ready` reports whether every lane has
# completed at least one successful cycle.
ROLEDAWN_WORKER_HEALTH_HOST=0.0.0.0
ROLEDAWN_WORKER_HEALTH_PORT=8788
ROLEDAWN_WORKER_CATALOG_INTERVAL_MS=30000
ROLEDAWN_WORKER_PREPARATION_INTERVAL_MS=2000
ROLEDAWN_WORKER_KIT_INTERVAL_MS=2000
ROLEDAWN_WORKER_FILL_INTERVAL_MS=5000
ROLEDAWN_WORKER_BUSY_INTERVAL_MS=250
ROLEDAWN_WORKER_ERROR_BACKOFF_BASE_MS=1000
ROLEDAWN_WORKER_ERROR_BACKOFF_MAX_MS=60000
# Explicit synthetic-only provider acceptance. This targets example.com and
# must remain false during ordinary development.
RUN_BROWSERBASE_SMOKE_ACCEPTANCE=false

# Optional local-only shortcut around email delivery. The server action still
# creates a normal Supabase Auth session and exercises auth.uid() and RLS. It is
# ignored outside `next dev`, on non-loopback origins, without the server secret,
# or when the fixed account does not use the reserved `.invalid` domain.
ENABLE_LOCAL_TEST_LOGIN=false
LOCAL_TEST_USER_EMAIL=roledawn-test@local.invalid
LOCAL_TEST_USER_DISPLAY_NAME=RoleDawn Test Candidate

# Explicit, destructive hosted-acceptance gates. Leave unset during ordinary
# development. The project ref must exactly match NEXT_PUBLIC_SUPABASE_URL.
ACCEPTANCE_EXPECTED_SUPABASE_PROJECT_REF=your-project-ref
RUN_HOSTED_MILESTONE_ZERO_ACCEPTANCE=false
# The Career Vault harness and its permanent-cleanup command each require their
# own exact acknowledgement. Keep both false during ordinary development.
RUN_HOSTED_CAREER_VAULT_ACCEPTANCE=false
RUN_HOSTED_CAREER_VAULT_CLEANUP=false
ACCEPTANCE_JOB_URL=https://job-boards.greenhouse.io/anthropic/jobs/5101378008
ACCEPTANCE_RUN_WORKER=false
ACCEPTANCE_KEEP_ARTIFACTS=false

# Read-only Gmail for employer verification codes (D-106). Create a Google OAuth
# "Web application" client with the Gmail API enabled and the
# https://www.googleapis.com/auth/gmail.readonly scope on its consent screen, and
# add <APP_BASE_URL>/api/mailbox/google/callback as an authorized redirect URI.
# Leave these empty to disable "Connect Gmail" (candidates then type codes).
GOOGLE_MAILBOX_CLIENT_ID=
GOOGLE_MAILBOX_CLIENT_SECRET=
# 32 random bytes, base64 (for example `openssl rand -base64 32`). Seals stored
# refresh tokens; changing it disconnects every mailbox.
ROLEDAWN_MAILBOX_TOKEN_KEY=
