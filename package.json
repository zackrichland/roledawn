{
  "name": "roledawn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:full": "node --experimental-strip-types scripts/run-local-stack.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check:docs": "node scripts/check-markdown-links.mjs",
    "auth:check-google": "node --experimental-strip-types --env-file=.env.local scripts/check-google-oauth.ts",
    "test": "node --test --experimental-strip-types src/domain/*.test.ts src/lib/supabase/*.test.ts src/server/applications/*.test.ts src/server/auth/*.test.ts src/server/ingestion/*.test.ts src/server/mailbox/*.test.ts src/server/opportunities/*.test.ts src/server/resume/*.test.ts src/server/vault/*.test.ts src/server/workers/*.test.ts scripts/*.test.ts",
    "typecheck": "tsc --noEmit",
    "worker:once": "node --experimental-strip-types --env-file=.env.local scripts/run-preparation-worker.ts",
    "worker:catalog": "node --experimental-strip-types --env-file=.env.local scripts/run-job-source-worker.ts",
    "worker:kit": "node --experimental-strip-types --env-file=.env.local scripts/run-application-kit-worker.ts",
    "worker:fill": "node --experimental-strip-types --env-file=.env.local scripts/run-application-fill-worker.ts",
    "worker:autopilot": "node --experimental-strip-types --env-file=.env.local scripts/run-application-autopilot-worker.ts",
    "worker:service": "node --experimental-strip-types --env-file=.env.local scripts/run-worker-service.ts",
    "acceptance:kit": "node --experimental-strip-types --env-file=.env.local scripts/run-application-kit-acceptance.ts",
    "acceptance:m0": "node --experimental-strip-types --env-file=.env.local scripts/run-milestone-zero-acceptance.ts",
    "acceptance:vault": "node --experimental-strip-types --env-file=.env.local scripts/run-career-vault-acceptance.ts",
    "acceptance:profile": "node --experimental-strip-types --env-file=.env.local scripts/run-candidate-profile-acceptance.ts",
    "acceptance:evidence": "node --experimental-strip-types --env-file=.env.local scripts/run-candidate-evidence-acceptance.ts",
    "acceptance:evidence:cleanup": "node --experimental-strip-types --env-file=.env.local scripts/cleanup-candidate-evidence-acceptance.ts",
    "acceptance:drafting:live": "node --experimental-strip-types --env-file=.env.local scripts/run-live-drafting-acceptance.ts",
    "acceptance:browserbase": "node --experimental-strip-types --env-file=.env.local scripts/run-browserbase-smoke-acceptance.ts",
    "acceptance:greenhouse": "node --experimental-strip-types --env-file=.env.local scripts/run-greenhouse-browserbase-acceptance.ts",
    "acceptance:opportunity": "node --experimental-strip-types --env-file=.env.local scripts/run-opportunity-catalog-acceptance.ts",
    "acceptance:opportunity:cleanup": "node --experimental-strip-types --env-file=.env.local scripts/cleanup-opportunity-catalog-acceptance.ts",
    "acceptance:profile:cleanup": "node --experimental-strip-types --env-file=.env.local scripts/cleanup-candidate-profile-acceptance.ts",
    "dogfood:seed-candidate": "node --experimental-strip-types --env-file=.env.local scripts/seed-dogfood-candidate.ts",
    "acceptance:vault:cleanup": "node --experimental-strip-types --env-file=.env.local scripts/cleanup-career-vault-acceptance.ts",
    "acceptance:m0:cleanup": "node --experimental-strip-types --env-file=.env.local scripts/cleanup-milestone-zero-acceptance.ts",
    "acceptance:agents": "node --experimental-strip-types --env-file=.env.local scripts/run-agents-form-acceptance.ts",
    "acceptance:delivery": "node --experimental-strip-types --env-file=.env.local scripts/run-application-delivery-acceptance.ts",
    "agents:cleanup": "node --experimental-strip-types --env-file=.env.local scripts/cleanup-application-agent-sessions.ts",
    "catalog:seed": "node --experimental-strip-types --env-file=.env.local scripts/seed-reviewed-job-sources.ts",
    "worker:catalog:daily": "node --experimental-strip-types --env-file=.env.local scripts/run-daily-job-catalog.ts",
    "acceptance:delivery:fullstack": "node --experimental-strip-types --env-file=.env.local scripts/run-application-delivery-fullstack-acceptance.ts",
    "eval:writing": "node --experimental-strip-types scripts/eval-application-writing.ts",
    "acceptance:upload:direct": "node --experimental-strip-types --env-file=.env.local scripts/run-direct-resume-upload-acceptance.ts"
  },
  "dependencies": {
    "@browserbasehq/sdk": "2.18.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "docx": "9.7.1",
    "fontkit": "2.0.4",
    "mammoth": "1.12.1",
    "next": "^16.3.5",
    "openai": "7.4.0",
    "pdfkit": "0.19.1",
    "playwright-core": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "unpdf": "1.8.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@netlify/functions": "^6.0.0",
    "@types/node": "26.1.2",
    "@types/pdfkit": "0.17.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.3.5",
    "jszip": "3.10.1",
    "supabase": "2.113.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
