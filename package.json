{
  "name": "roledawn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check:docs": "node scripts/check-markdown-links.mjs",
    "test": "node --test --experimental-strip-types src/domain/*.test.ts src/server/auth/*-policy.test.ts src/server/ingestion/*.test.ts src/server/workers/*.test.ts scripts/*.test.ts",
    "typecheck": "tsc --noEmit",
    "worker:once": "node --experimental-strip-types --env-file=.env.local scripts/run-preparation-worker.ts",
    "acceptance:m0": "node --experimental-strip-types --env-file=.env.local scripts/run-milestone-zero-acceptance.ts",
    "acceptance:m0:cleanup": "node --experimental-strip-types --env-file=.env.local scripts/cleanup-milestone-zero-acceptance.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "supabase": "2.113.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
