      "isDeleted": false,
      "boundElements": [],
      "updated": 1786032000000,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 2,
      "text": "Solid arrow = command, domain event, or typed result.   Dashed arrow = credential lease, operational control, provider bridge, or takeover exception.   Every consequential write uses an idempotency key.   Any material change invalidates approval.   Uncertain submission state blocks retry until reconciliation.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Solid arrow = command, domain event, or typed result.   Dashed arrow = credential lease, operational control, provider bridge, or takeover exception.   Every consequential write uses an idempotency key.   Any material change invalidates approval.   Uncertain submission state blocks retry until reconciliation.",
      "autoResize": false,
      "lineHeight": 1.25
    },
